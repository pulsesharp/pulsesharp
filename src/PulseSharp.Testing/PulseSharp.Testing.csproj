<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PulseSharp.Testing</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Test helpers for apps that use PulseSharp: a recording IPulse, ready-made handler contexts, and a test host with the real engine that waits until every handler is done. Works with any test framework.</Description>
    <PackageTags>$(PackageTags);testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PulseSharp\PulseSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PulseSharp.Tests" />
  </ItemGroup>

</Project>
