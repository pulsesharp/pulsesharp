<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PulseSharp.Tests</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PulseSharp\PulseSharp.csproj" />
    <ProjectReference Include="..\..\src\PulseSharp.Sqlite\PulseSharp.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\PulseSharp.PostgreSql\PulseSharp.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\PulseSharp.Sync\PulseSharp.Sync.csproj" />
    <ProjectReference Include="..\..\src\PulseSharp.Sync.Server\PulseSharp.Sync.Server.csproj" />
    <ProjectReference Include="..\..\src\PulseSharp.Testing\PulseSharp.Testing.csproj" />
    <ProjectReference Include="..\PulseSharp.CrashApp\PulseSharp.CrashApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PulseSharp.OldVersionApp\PulseSharp.OldVersionApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
